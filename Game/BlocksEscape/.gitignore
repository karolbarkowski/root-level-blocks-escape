# Unity project. Commit only Assets/, Packages/ and ProjectSettings/ (with every .meta file);
# everything below is regenerated by Unity or the IDE.

# Generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IDE files Unity regenerates (Assets > Open C# Project). .vsconfig stays committed.
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Build and crash output
sysinfo.txt
mono_crash.*
crashlytics-buildid.txt
*.apk
*.aab
*.unitypackage
*.app

# The root .gitignore's NuGet rule would hide Unity's package manifest and per-package settings.
!/[Pp]ackages/*
!/[Pp]roject[Ss]ettings/[Pp]ackages/**
