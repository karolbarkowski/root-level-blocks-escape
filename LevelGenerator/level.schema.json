{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Block puzzle v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "rules", "board", "blocks"],
  "properties": {
    "format": { "const": "block-puzzle/v2" },
    "rules": { "const": "grid-drag-drop/v1" },
    "seed": { "type": "integer" },
    "board": { "$ref": "#/$defs/layout" },
    "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } },
    "solution": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["block", "to"], "properties": { "block": { "type": "string", "minLength": 1 }, "to": { "$ref": "#/$defs/cell" } } } },
    "analysis": { "type": "object" }
  },
  "$defs": {
    "cell": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "integer", "minimum": 0, "maximum": 19 }, "y": { "type": "integer", "minimum": 0, "maximum": 19 } } },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "side", "start", "length", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "side": { "enum": ["top", "right", "bottom", "left"] },
        "start": { "type": "integer", "minimum": 0, "maximum": 19 },
        "length": { "type": "integer", "minimum": 1, "maximum": 20 },
        "type": { "type": "string", "minLength": 1, "description": "Block type id from Shared/BlockTypes/block-types.json" },
        "line": { "type": "integer", "minimum": 0, "maximum": 19 }
      }
    },
    "layout": {
      "type": "object", "additionalProperties": false, "required": ["width", "height", "walls", "gates"],
      "allOf": [{
        "if": { "required": ["boundaryMode"], "properties": { "boundaryMode": { "const": "enclosed" } } },
        "then": { "properties": { "gates": { "items": { "required": ["line"] } } } },
        "else": { "properties": { "gates": { "items": { "not": { "required": ["line"] } } } } }
      }],
      "properties": {
        "width": { "type": "integer", "minimum": 2, "maximum": 20 },
        "height": { "type": "integer", "minimum": 2, "maximum": 20 },
        "boundaryMode": { "enum": ["rectangle", "enclosed"], "default": "rectangle" },
        "walls": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/cell" } },
        "gates": { "type": "array", "items": { "$ref": "#/$defs/gate" } }
      }
    },
    "block": {
      "type": "object", "additionalProperties": false, "required": ["id", "shape", "position", "types"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "shape": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/cell" } },
        "position": { "$ref": "#/$defs/cell" },
        "types": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1 }, "description": "Block type ids, outside to inside; empty for a neutral blocker" },
        "axis": { "enum": ["free", "horizontal", "vertical"], "default": "free" },
        "frozenFor": { "type": "integer", "minimum": 0, "default": 0 }
      }
    }
  }
}

