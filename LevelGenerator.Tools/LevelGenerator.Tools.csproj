<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)../LevelGenerator/NuGet.Config</RestoreConfigFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Uses the generator's public Search (solver) and Renderer (SVG/HTML replay). -->
    <ProjectReference Include="../LevelGenerator/LevelGenerator.csproj" />
  </ItemGroup>
</Project>
